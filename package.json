{
  "name": "pawtrol",
  "version": "1.0.0",
  "private": true,
  "description": "Pawtrol: a privacy-first browser agent that redacts sensitive data on-device before anything reaches a model.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests",
    "test": "vitest run",
    "e2e": "node tests/e2e/smoke.mjs",
    "test:vision": "node tests/e2e/vision-verification.mjs",
    "bench": "node bench/agent/run.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "site": "node scripts/package-site.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.120.0",
    "onnxruntime-web": "^1.30.0",
    "openai": "7.5.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.0",
    "@types/node": "^24.13.5",
    "esbuild": "^0.28.2",
    "playwright": "^1.63.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
